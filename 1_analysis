    /Number of paired-end alignments with a unique best hit:/ {uni=$NF}
    /Mapping efficiency:/ {eff=$3}
    /Sequence pairs with no alignments under any condition:/ {noal=$NF}
    /Sequence pairs did not map uniquely:/ {multi=$NF}
    END{print S"\t"tot"\t"uni"\t"eff"\t"noal"\t"multi}
  ' >> $out
