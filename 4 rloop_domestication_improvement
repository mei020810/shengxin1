# /mnt/nfs2/stu_fy/hms/China.G.soja_landrace.fst.pi.overlap.top5%.gene 和 /mnt/nfs2/stu_fy/hms/China.landrace_improved.fst.pi.overlap.top5%.gene 驯化和改良相关的基因
# 需要看一下驯化和改良相关的基因与Rloop 的关系，可以看这些基因和Rloop 相关基因的 overlap 韦恩图，也可以看 这些基因的deeptools 热图   和随机的非驯化基因的 作对照

# 得到个品种的Rloop基因
for i in HC22 HH43 HX3 Wm82 ZH13;do
  cat /data/mshe/rloopData/sense_anti_overlap/${i}_IP_sense_ids.txt /data/mshe/rloopData/sense_anti_overlap/${i}_IP_anti_ids.txt | sort -u > /data/mshe/rloopData/sense_anti_overlap/${i}_IP_all_ids.txt
done
# 获得改良和驯化基因ID
awk -F'ID=|;' '{print $2}' /mnt/nfs2/stu_fy/hms/China.landrace_improved.fst.pi.overlap.top5%.gene \
  | sort -u > /data/mshe/rloopData/China.landrace_improved.top5.IDs.txt  #改良基因
awk -F'ID=|;' '{print $2}' /mnt/nfs2/stu_fy/hms/China.G.soja_landrace.fst.pi.overlap.top5%.gene \
  | sort -u > /data/mshe/rloopData/China.G.soja_landrace.top5.IDs.txt   #驯化基因
mv China.G.soja_landrace.top5.IDs.txt domestication_ids.txt  #改名
mv China.landrace_improved.top5.IDs.txt improvement_ids.txt
mkdir dom_imp_rloop
mv domestication_ids.txt dom_imp_rloop/
mv improvement_ids.txt dom_imp_rloop/

cd /data/mshe/rloopData
conda activate chipseeker_r4.3
# install.packages("VennDiagram")
vim venn_dom_imp_rloop.R
args <- commandArgs(trailingOnly = TRUE)
if (length(args) != 4) {
  stop("Usage: Rscript venn_dom_imp_rloop.R dom.txt imp.txt rloop.txt out.pdf")
}

suppressPackageStartupMessages({
  library(VennDiagram)
  library(grid)
})

read_ids <- function(f) unique(trimws(readLines(f, warn = FALSE)))

A <- read_ids(args[1])
B <- read_ids(args[2])
C <- read_ids(args[3])
out_pdf <- args[4]

morandi <- c(
  Domestication = "#A3B18A",  # 鼠尾草绿
  Improvement   = "#D4A5A5",  # 灰粉
  Rloop         = "#9BB7D4"   # 雾霾蓝
)

pdf(out_pdf, width = 7, height = 7)
grid.newpage()
title_text <- sub("\\.pdf$","",basename(out_pdf))
grid.text(title_text, y = unit(0.98, "npc"), gp = gpar(fontsize = 16, fontface = "bold"))

vp <- venn.diagram(
  x = list(Domestication = A, Improvement = B, Rloop = C),
  filename = NULL,
  euler.d  = FALSE,
  scaled   = FALSE,             # 交集为0也保持圈重叠
  fill     = unname(morandi),   # 莫兰迪色
  alpha    = 0.55,              # 加透明度
  col      = "black",
  lwd      = 2,
  cex      = 1.2,               # 数字大小
  margin   = 0.1,
  cat.cex  = 1.3,               # 集合名大小
  cat.col  = "black"
)
grid.draw(vp)
dev.off()
message("Wrote: ", out_pdf)

for i in HC22 HH43 HX3 Wm82 ZH13;do
  Rscript venn_dom_imp_rloop.R dom_imp_rloop/domestication_ids.txt dom_imp_rloop/improvement_ids.txt sense_anti_overlap/${i}_IP_all_ids.txt dom_imp_rloop/${i}_IP_venn.pdf
done

# 将分隔符统一换成tab+排序+去重
awk 'BEGIN{OFS="\t"} NF>=6 {gsub(/\r$/,""); print $1,$2,$3,$4,$5,$6}' "annotation/genes_fixed.bed" | sort -k1,1 -k2,2n -k3,3n -k4,4 -k5,5n -k6,6 | uniq > "annotation/genes_fixed_sorted.bed"
LC_ALL=C sort -c -k1,1 -k2,2n -k3,3n /data/mshe/rloopData/annotation/genes_fixed_sorted.bed  # 验证排序是否成功，无输出就行
awk '$6=="+"' "/data/mshe/rloopData/annotation/genes_fixed_sorted.bed" > "/data/mshe/rloopData/annotation/genes_plus1_sorted.bed"
awk '$6=="-"' "/data/mshe/rloopData/annotation/genes_fixed_sorted.bed" > "/data/mshe/rloopData/annotation/genes_minus1_sorted.bed"

## 做该基因的deeptools热图
mkdir -p dom_imp_rloop/bed
ALLBED=/data/mshe/rloopData/annotation/genes_fixed_sorted.bed
# 驯化基因→bed
grep -F -f dom_imp_rloop/domestication_ids.txt $ALLBED > dom_imp_rloop/bed/domestication_genes.bed
# 改良基因→bed
grep -F -f dom_imp_rloop/improvement_ids.txt $ALLBED > dom_imp_rloop/bed/improvement_genes.bed
# 所有基因组的id
mkdir -p dom_imp_rloop/random
cut -f4 $ALLBED | sort -u > dom_imp_rloop/random/all_gene_ids.txt
# 驯化与改良基因id的合并
cat dom_imp_rloop/domestication_ids.txt dom_imp_rloop/improvement_ids.txt | sort -u \
  > dom_imp_rloop/random/dom_imp_ids.txt
# 非驯化ID池 = 全基因 - (驯化∪改良)
comm -23 dom_imp_rloop/random/all_gene_ids.txt dom_imp_rloop/random/dom_imp_ids.txt \
  > dom_imp_rloop/random/non_domimp_ids_pool.txt
# 抽取随机对照（数量 = 驯化基因数量）
N=$(wc -l < dom_imp_rloop/domestication_ids.txt)
shuf -n $N dom_imp_rloop/random/non_domimp_ids_pool.txt \
  > dom_imp_rloop/random/random_non_domimp_ids.txt
# 随机对照 -> BED
grep -F -f dom_imp_rloop/random/random_non_domimp_ids.txt $ALLBED \
  > dom_imp_rloop/bed/random_non_domimp_genes.bed
# 抽取20份随机对照
ALLBED=/data/mshe/rloopData/annotation/genes_fixed_sorted.bed
POOL=dom_imp_rloop/random/non_domimp_ids_pool.txt
OUTDIR=dom_imp_rloop/random/repeats
BEDOUT=dom_imp_rloop/bed/random_repeats
mkdir -p "$OUTDIR" "$BEDOUT"
N=$(wc -l < dom_imp_rloop/domestication_ids.txt)
for i in $(seq -w 01 20); do
  # 1) 抽一份随机ID
  shuf -n "$N" "$POOL" > "$OUTDIR/random_${i}.ids"
  # 2) 转成 BED
  grep -F -f "$OUTDIR/random_${i}.ids" "$ALLBED" \
    | sort -k1,1 -k2,2n -k3,3n | uniq \
    > "$BEDOUT/random_${i}.bed"
  echo "random_${i}: $(wc -l < "$BEDOUT/random_${i}.bed")"
done
