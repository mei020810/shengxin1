    if [ ! -f "${DEEPTOOLS_DIR}/${variety}_four_panel_cRloop_matrix.gz" ]; then
        echo "错误: 矩阵生成失败 - ${variety}"
        continue
    fi

    # 绘制四面板热图
    plotHeatmap \
        -m "${DEEPTOOLS_DIR}/${variety}_four_panel_cRloop_matrix.gz" \
        -o "${DEEPTOOLS_DIR}/${variety}_four_panel_cRloop_heatmap.pdf" \
        --colorMap Blues \
        --whatToShow 'heatmap and colorbar' \
        --samplesLabel "${sample_labels[@]}" \
        --plotTitle "${variety} cRloop Signal" \
        --refPointLabel "Summit" \
        --legendLocation "upper-right" \
        --xAxisLabel "Distance from summit (bp)" \
        --yAxisLabel "" \
        --perGroup \
	--dpi 300
done

chmod u+x deeptools_four_panel_cRloop.sh
./deeptools_four_panel_cRloop.sh

