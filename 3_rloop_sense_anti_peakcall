vim create_gene_bed.sh
#!/bin/bash
WCRLOOP_DIR="/data/mshe/rloopData/macs3_results_merge_wcRloop"
ANNOTATION_DIR="/data/mshe/rloopData/annotation"
OUTPUT_DIR="/data/mshe/rloopData/final_gene_regions"
mkdir -p "$OUTPUT_DIR"
echo "=== 生成有R-loop peak的sense/antisense基因区域BED==="
for variety in HC22 HH43 HX3 Wm82 ZH13; do
    for type in IP input; do
    echo "处理品种: ${variety} ${type}"
WRLOOP_PEAKS="${WCRLOOP_DIR}/${variety}_${type}_x800_bw2_wRloop_nomodel.macs3_peaks.narrowPeak" CRLOOP_PEAKS="${WCRLOOP_DIR}/${variety}_${type}_x800_bw2_cRloop_nomodel.macs3_peaks.narrowPeak"
    GENES_PLUS="${ANNOTATION_DIR}/genes_plus.bed"    
    GENES_MINUS="${ANNOTATION_DIR}/genes_minus.bed" 
    # Sense基因：有wRloop peak的正链基因 + 有cRloop peak的负链基因
    # 使用 -wa 保留基因注释的所有列
    bedtools intersect -a "$GENES_PLUS" -b "$WRLOOP_PEAKS" -wa -u > \
        "${OUTPUT_DIR}/${variety}_${type}_wRloop_sense_genes.bed"
    bedtools intersect -a "$GENES_MINUS" -b "$CRLOOP_PEAKS" -wa -u > \
        "${OUTPUT_DIR}/${variety}_${type}_cRloop_sense_genes.bed"

    cat "${OUTPUT_DIR}/${variety}_${type}_wRloop_sense_genes.bed" \
        "${OUTPUT_DIR}/${variety}_${type}_cRloop_sense_genes.bed" | \
        sort -k1,1 -k2,2n > \
        "${OUTPUT_DIR}/${variety}_${type}_sense_genes.bed"    
    # Antisense基因：有wRloop peak的负链基因 + 有cRloop peak的正链基因  
    bedtools intersect -a "$GENES_MINUS" -b "$WRLOOP_PEAKS" -wa -u > \
        "${OUTPUT_DIR}/${variety}_${type}_wRloop_antisense_genes.bed"
    bedtools intersect -a "$GENES_PLUS" -b "$CRLOOP_PEAKS" -wa -u > \
        "${OUTPUT_DIR}/${variety}_${type}_cRloop_antisense_genes.bed"
    
    cat "${OUTPUT_DIR}/${variety}_${type}_wRloop_antisense_genes.bed" \
        "${OUTPUT_DIR}/${variety}_${type}_cRloop_antisense_genes.bed" | \
        sort -k1,1 -k2,2n > \
        "${OUTPUT_DIR}/${variety}_${type}_antisense_genes.bed"
    echo "  验证BED文件列数和strand信息:"
    echo "  Sense genes列数: $(awk '{print NF}' "${OUTPUT_DIR}/${variety}_${type}_sense_genes.bed" | sort -nu)"
    echo "  Sense genes strand分布:"
    awk '{print $6}' "${OUTPUT_DIR}/${variety}_${type}_sense_genes.bed" | sort | uniq -c || echo "无strand列"
    echo "  Antisense genes列数: $(awk '{print NF}' "${OUTPUT_DIR}/${variety}_${type}_antisense_genes.bed" | sort -nu)" 
    awk '{print $6}' "${OUTPUT_DIR}/${variety}_${type}_antisense_genes.bed" | sort | uniq -c || echo "无strand列"
done
done
chmod u+x create_gene_bed.sh
./create_gene_bed.sh

vim merge_intergenic_bed.sh
#!/bin/bash
PEAK_DIR="/data/mshe/rloopData/final_sense_anti_bam/peak"
INTERGENIC_BED="/data/mshe/rloopData/annotation/intergenic_regions.bed"
OUTPUT_DIR="/data/mshe/rloopData/final_sense_anti_bam/intergenic_peak"
mkdir -p "$OUTPUT_DIR"

echo "=== 合并wRloop和cRloop的基因间区域peaks ==="
[ ! -f "$INTERGENIC_BED" ] && echo "错误: 找不到基因间区域文件" && exit 1
for variety in HC22 HH43 HX3 Wm82 ZH13; do
    echo "处理品种: $variety"
    for type in IP input; do
        echo "  处理$type数据..."
        
        # 合并sense peaks
        cat "${PEAK_DIR}/${variety}_${type}_wRloop_sense.bed" \
            "${PEAK_DIR}/${variety}_${type}_cRloop_sense.bed" 2>/dev/null | \
            bedtools intersect -a stdin -b "$INTERGENIC_BED" -wa -u | \
            sort -k1,1 -k2,2n | bedtools merge -i stdin > \
            "${OUTPUT_DIR}/${variety}_${type}_sense_intergenic.bed"
        
        # 合并antisense peaks
        cat "${PEAK_DIR}/${variety}_${type}_wRloop_antisense.bed" \
            "${PEAK_DIR}/${variety}_${type}_cRloop_antisense.bed" 2>/dev/null | \
            bedtools intersect -a stdin -b "$INTERGENIC_BED" -wa -u | \
            sort -k1,1 -k2,2n | bedtools merge -i stdin > \
            "${OUTPUT_DIR}/${variety}_${type}_antisense_intergenic.bed"
        
        # 统计
        sense_count=$(wc -l < "${OUTPUT_DIR}/${variety}_${type}_sense_intergenic.bed" 2>/dev/null || echo "0")
        anti_count=$(wc -l < "${OUTPUT_DIR}/${variety}_${type}_antisense_intergenic.bed" 2>/dev/null || echo "0")
        echo "    ${type}: Sense=$sense_count, Anti=$anti_count"
    done
done
echo "=== 完成 ==="
echo "输出文件列表:"
ls -1 "${OUTPUT_DIR}"/*.bed
chmod u+x merge_intergenic_bed.sh
./merge_intergenic_bed.sh

