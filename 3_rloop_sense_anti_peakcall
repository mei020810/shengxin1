#!/bin/bash
set -euo pipefail
WCRLOOP_DIR="/data/mshe/rloopData/merge_rep_bam_wcRloop"
ANNOTATION_DIR="/data/mshe/rloopData/annotation"
OUTPUT_DIR="/data/mshe/rloopData/final_sense_anti_bam/sense_anti_bed"
mkdir -p "$OUTPUT_DIR"

for wrloop_bam in ${WCRLOOP_DIR}/*_wRloop.merged.bam; do
    sample=$(basename "$wrloop_bam" _wRloop.merged.bam)
    echo "处理wRloop样本: $sample"
    echo "识别Sense R-loops..."
    
    # 先将BAM转换为BED格式（也可以用管道传递，绕过中间文件生成bedtools bamtobed -i "merge_rep_bam_wcRloop/HC22_input_wRloop.merged.bam" | bedtools intersect -a stdin -b "annotation/genes_plus1.bed" -wa | head）
    bedtools bamtobed -i "$wrloop_bam" > "${OUTPUT_DIR}/${sample}_wRloop_all.bed"
    
    # wRloop + 正链基因 → sense
    bedtools intersect -a "${OUTPUT_DIR}/${sample}_wRloop_all.bed" -b "${ANNOTATION_DIR}/genes_plus1.bed" -wa > \
        "${OUTPUT_DIR}/${sample}_wRloop_sense.bed"
    # wRloop + 负链基因 → anti-sense
    bedtools intersect -a "${OUTPUT_DIR}/${sample}_wRloop_all.bed" -b "${ANNOTATION_DIR}/genes_minus1.bed" -wa > \
        "${OUTPUT_DIR}/${sample}_wRloop_antisense.bed"
    # wRloop intergenic
    bedtools intersect -a "${OUTPUT_DIR}/${sample}_wRloop_all.bed" -b "${ANNOTATION_DIR}/genes_fixed.bed" -v > \
        "${OUTPUT_DIR}/${sample}_wRloop_intergenic.bed"
    
    echo "  Sense: $(wc -l < ${OUTPUT_DIR}/${sample}_wRloop_sense.bed)"
    echo "  Anti-sense: $(wc -l < ${OUTPUT_DIR}/${sample}_wRloop_antisense.bed)"
    echo "  Intergenic: $(wc -l < ${OUTPUT_DIR}/${sample}_wRloop_intergenic.bed)"
    
    # 清理临时文件
    rm "${OUTPUT_DIR}/${sample}_wRloop_all.bed"
done

for crloop_bam in ${WCRLOOP_DIR}/*_cRloop.merged.bam; do
    sample=$(basename "$crloop_bam" _cRloop.merged.bam)
    echo "处理cRloop样本: $sample"
    echo "识别Sense R-loops..."
    
    # 先将BAM转换为BED格式
    bedtools bamtobed -i "$crloop_bam" > "${OUTPUT_DIR}/${sample}_cRloop_all.bed"
    
    # cRloop + 负链基因 → sense
    bedtools intersect -a "${OUTPUT_DIR}/${sample}_cRloop_all.bed" -b "${ANNOTATION_DIR}/genes_minus1.bed" -wa > \
        "${OUTPUT_DIR}/${sample}_cRloop_sense.bed"
    # cRloop + 正链基因 → anti-sense
    bedtools intersect -a "${OUTPUT_DIR}/${sample}_cRloop_all.bed" -b "${ANNOTATION_DIR}/genes_plus1.bed" -wa > \
        "${OUTPUT_DIR}/${sample}_cRloop_antisense.bed"
    # cRloop intergenic
    bedtools intersect -a "${OUTPUT_DIR}/${sample}_cRloop_all.bed" -b "${ANNOTATION_DIR}/genes_fixed.bed" -v > \
        "${OUTPUT_DIR}/${sample}_cRloop_intergenic.bed"
    
    echo "  Sense: $(wc -l < ${OUTPUT_DIR}/${sample}_cRloop_sense.bed)"
    echo "  Anti-sense: $(wc -l < ${OUTPUT_DIR}/${sample}_cRloop_antisense.bed)"
    echo "  Intergenic: $(wc -l < ${OUTPUT_DIR}/${sample}_cRloop_intergenic.bed)"
    
    # 清理临时文件
    rm "${OUTPUT_DIR}/${sample}_cRloop_all.bed"
done

# 然后按品种合并
for variety in HC22 HH43 HX3 Wm82 ZH13; do
    echo "合并品种: $variety"
    
    # 合并sense peaks
    cat "${OUTPUT_DIR}/${variety}_IP_wRloop_sense.bed" \
        "${OUTPUT_DIR}/${variety}_IP_cRloop_sense.bed" 2>/dev/null | \
        sort -k1,1 -k2,2n | uniq > \
        "${OUTPUT_DIR}/${variety}_IP_sense.bed"
    
    cat "${OUTPUT_DIR}/${variety}_input_wRloop_sense.bed" \
        "${OUTPUT_DIR}/${variety}_input_cRloop_sense.bed" 2>/dev/null | \
        sort -k1,1 -k2,2n | uniq > \
        "${OUTPUT_DIR}/${variety}_input_sense.bed"
    
    # 合并anti-sense peaks
    cat "${OUTPUT_DIR}/${variety}_IP_wRloop_antisense.bed" \
        "${OUTPUT_DIR}/${variety}_IP_cRloop_antisense.bed" 2>/dev/null | \
        sort -k1,1 -k2,2n | uniq > \
        "${OUTPUT_DIR}/${variety}_IP_antisense.bed"
    
    cat "${OUTPUT_DIR}/${variety}_input_wRloop_antisense.bed" \
        "${OUTPUT_DIR}/${variety}_input_cRloop_antisense.bed" 2>/dev/null | \
        sort -k1,1 -k2,2n | uniq > \
        "${OUTPUT_DIR}/${variety}_input_antisense.bed"
    
    # 合并intergenic peaks
    cat "${OUTPUT_DIR}/${variety}_IP_wRloop_intergenic.bed" \
        "${OUTPUT_DIR}/${variety}_IP_cRloop_intergenic.bed" 2>/dev/null | \
        sort -k1,1 -k2,2n | uniq > \
        "${OUTPUT_DIR}/${variety}_IP_intergenic.bed"
    
    cat "${OUTPUT_DIR}/${variety}_input_wRloop_intergenic.bed" \
        "${OUTPUT_DIR}/${variety}_input_cRloop_intergenic.bed" 2>/dev/null | \
        sort -k1,1 -k2,2n | uniq > \
        "${OUTPUT_DIR}/${variety}_input_intergenic.bed"

    sense_IP_count=$(wc -l < "${OUTPUT_DIR}/${variety}_IP_sense.bed")
    antisense_IP_count=$(wc -l < "${OUTPUT_DIR}/${variety}_IP_antisense.bed")
    intergenic_IP_count=$(wc -l < "${OUTPUT_DIR}/${variety}_IP_intergenic.bed")
    sense_input_count=$(wc -l < "${OUTPUT_DIR}/${variety}_input_sense.bed")
    antisense_input_count=$(wc -l < "${OUTPUT_DIR}/${variety}_input_antisense.bed")
    intergenic_input_count=$(wc -l < "${OUTPUT_DIR}/${variety}_input_intergenic.bed")
    
    echo "  Sense IP bed: $sense_IP_count"
    echo "  Anti-sense IP bed: $antisense_IP_count"
    echo "  intergenic IP bed: $intergenic_IP_count"
    echo "  Sense input bed: $sense_input_count"
    echo "  Anti-sense input bed: $antisense_input_count"
    echo "  intergenic input bed: $intergenic_input_count"
done
chmod u+x sense_anti_classify_final.sh
nohup ./sense_anti_classify_final.sh > sense_anti_classify_final.log 2>&1 &



vim merge_intergenic_bed.sh
#!/bin/bash
PEAK_DIR="/data/mshe/rloopData/final_sense_anti_bam/peak"
INTERGENIC_BED="/data/mshe/rloopData/annotation/intergenic_regions.bed"
OUTPUT_DIR="/data/mshe/rloopData/final_sense_anti_bam/intergenic_peak"
mkdir -p "$OUTPUT_DIR"

echo "=== 合并wRloop和cRloop的基因间区域peaks ==="
[ ! -f "$INTERGENIC_BED" ] && echo "错误: 找不到基因间区域文件" && exit 1
for variety in HC22 HH43 HX3 Wm82 ZH13; do
    echo "处理品种: $variety"
    for type in IP input; do
        echo "  处理$type数据..."
        
        # 合并sense peaks
        cat "${PEAK_DIR}/${variety}_${type}_wRloop_sense.bed" \
            "${PEAK_DIR}/${variety}_${type}_cRloop_sense.bed" 2>/dev/null | \
            bedtools intersect -a stdin -b "$INTERGENIC_BED" -wa -u | \
            sort -k1,1 -k2,2n | bedtools merge -i stdin > \
            "${OUTPUT_DIR}/${variety}_${type}_sense_intergenic.bed"
        
        # 合并antisense peaks
        cat "${PEAK_DIR}/${variety}_${type}_wRloop_antisense.bed" \
            "${PEAK_DIR}/${variety}_${type}_cRloop_antisense.bed" 2>/dev/null | \
            bedtools intersect -a stdin -b "$INTERGENIC_BED" -wa -u | \
            sort -k1,1 -k2,2n | bedtools merge -i stdin > \
            "${OUTPUT_DIR}/${variety}_${type}_antisense_intergenic.bed"
        
        # 统计
        sense_count=$(wc -l < "${OUTPUT_DIR}/${variety}_${type}_sense_intergenic.bed" 2>/dev/null || echo "0")
        anti_count=$(wc -l < "${OUTPUT_DIR}/${variety}_${type}_antisense_intergenic.bed" 2>/dev/null || echo "0")
        echo "    ${type}: Sense=$sense_count, Anti=$anti_count"
    done
done
echo "=== 完成 ==="
echo "输出文件列表:"
ls -1 "${OUTPUT_DIR}"/*.bed
chmod u+x merge_intergenic_bed.sh
./merge_intergenic_bed.sh

