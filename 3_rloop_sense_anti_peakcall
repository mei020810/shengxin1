vim sense_anti_classify_final.sh
#!/bin/bash
WCRLOOP_DIR="/data/mshe/rloopData/macs3_results_merge_wcRloop"
ANNOTATION_DIR="/data/mshe/rloopData/annotation"
OUTPUT_DIR="/data/mshe/rloopData/final_sense_anti_bam/peak"
mkdir -p "$OUTPUT_DIR"

# 为每个品种分类sense和anti peaks
for wrloop_peaks in ${WCRLOOP_DIR}/*_wRloop_nomodel.macs3_peaks.narrowPeak; do
    sample=$(basename "$wrloop_peaks" _x800_bw2_wRloop_nomodel.macs3_peaks.narrowPeak)
    if [ ! -f "$wrloop_peaks" ]; then
        echo "警告: wRloop peaks文件不存在 - $wrloop_peaks"
        continue
    fi
  echo "处理wRloop样本: $sample"
  echo "识别Sense R-loops..."
    # wRloop + 正链基因 → sense
    bedtools intersect -a "$wrloop_peaks" -b "${ANNOTATION_DIR}/genes_plus.bed" -wa -u > \
        "${OUTPUT_DIR}/${sample}_wRloop_sense.bed"
    # wRloop + 负链基因 → anti-sense
    bedtools intersect -a "$wrloop_peaks" -b "${ANNOTATION_DIR}/genes_minus.bed" -wa -u > \
        "${OUTPUT_DIR}/${sample}_wRloop_antisense.bed"
    echo "  Sense: $(wc -l < ${OUTPUT_DIR}/${sample}_wRloop_sense.bed)"
    echo "  Anti-sense: $(wc -l < ${OUTPUT_DIR}/${sample}_wRloop_antisense.bed)"
done

for crloop_peaks in ${WCRLOOP_DIR}/*_cRloop_nomodel.macs3_peaks.narrowPeak; do
    sample=$(basename "$crloop_peaks" _x800_bw2_cRloop_nomodel.macs3_peaks.narrowPeak)
    if [ ! -f "$crloop_peaks" ]; then
        echo "警告: cRloop peaks文件不存在 - $crloop_peaks"
        continue
    fi
  echo "处理cRloop样本: $sample"
  echo "识别Sense R-loops..."
    # cRloop + 负链基因 → sense
    bedtools intersect -a "$crloop_peaks" -b "${ANNOTATION_DIR}/genes_minus.bed" -wa -u > \
        "${OUTPUT_DIR}/${sample}_cRloop_sense.bed"
    # cRloop + 正链基因 → anti-sense
    bedtools intersect -a "$crloop_peaks" -b "${ANNOTATION_DIR}/genes_plus.bed" -wa -u > \
        "${OUTPUT_DIR}/${sample}_cRloop_antisense.bed"
    echo "  Sense: $(wc -l < ${OUTPUT_DIR}/${sample}_cRloop_sense.bed)"
    echo "  Anti-sense: $(wc -l < ${OUTPUT_DIR}/${sample}_cRloop_antisense.bed)"
done

# 然后按品种合并
for variety in HC22 HH43 HX3 Wm82 ZH13; do
    echo "合并品种: $variety"
    
    # 合并sense peaks
    cat "${OUTPUT_DIR}/${variety}_IP_wRloop_sense.bed" \
        "${OUTPUT_DIR}/${variety}_IP_cRloop_sense.bed" 2>/dev/null | \
        sort -k1,1 -k2,2n | bedtools merge -i - > \
        "${OUTPUT_DIR}/${variety}_IP_sense.bed"
    
    cat "${OUTPUT_DIR}/${variety}_input_wRloop_sense.bed" \
        "${OUTPUT_DIR}/${variety}_input_cRloop_sense.bed" 2>/dev/null | \
        sort -k1,1 -k2,2n | bedtools merge -i - > \
        "${OUTPUT_DIR}/${variety}_input_sense.bed"
    # 合并anti-sense peaks
    cat "${OUTPUT_DIR}/${variety}_IP_wRloop_antisense.bed" \
        "${OUTPUT_DIR}/${variety}_IP_cRloop_antisense.bed" 2>/dev/null | \
        sort -k1,1 -k2,2n | bedtools merge -i - > \
        "${OUTPUT_DIR}/${variety}_IP_antisense.bed"
    
    cat "${OUTPUT_DIR}/${variety}_input_wRloop_antisense.bed" \
        "${OUTPUT_DIR}/${variety}_input_cRloop_antisense.bed" 2>/dev/null | \
        sort -k1,1 -k2,2n | bedtools merge -i - > \
        "${OUTPUT_DIR}/${variety}_input_antisense.bed"

    sense_IP_count=$(wc -l < "${OUTPUT_DIR}/${variety}_IP_sense.bed")
    antisense_IP_count=$(wc -l < "${OUTPUT_DIR}/${variety}_IP_antisense.bed")
    sense_input_count=$(wc -l < "${OUTPUT_DIR}/${variety}_input_sense.bed")
    antisense_input_count=$(wc -l < "${OUTPUT_DIR}/${variety}_input_antisense.bed")

    
    echo "  Sense IP peaks: $sense_IP_count"
    echo "  Anti-sense IP peaks: $antisense_IP_count"
    echo "  Sense input peaks: $sense_input_count"
    echo "  Anti-sense input peaks: $antisense_input_count"
done
chmod u+x sense_anti_classify_final.sh
