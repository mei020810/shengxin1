#!/bin/bash
set -euo pipefail

Rscript -e '
library(ChIPseeker)
library(GenomicFeatures)
peak_dir <- "/data/mshe/rloopData/macs3_results_merge_wcRloop"
out_dir  <- "/data/mshe/rloopData/pieplot_wcRloop"
if (!dir.exists(out_dir)) {
  dir.create(out_dir, recursive = TRUE)
  message("Created output directory: ", out_dir)
} else {
  message("Output directory already exists: ", out_dir)
}
#建立注释包
txdb <- makeTxDbFromGFF("/data/mshe/rloopData/Gmax_508_Wm82.a4.v1.gene.gff3")

peak_files <- list.files(
  path = peak_dir,
  pattern = "_[wc]Rloop_nomodel.macs3_peaks.narrowPeak$",
  full.names = TRUE
)

message("Found peak files:")
print(peak_files)

for (peak_path in peak_files) {
  sample_name <- gsub(".macs3_peaks.narrowPeak", "", basename(peak_path))
  message("Processing: ", sample_name)
  peak <- readPeakFile(peak_path)
  peakAnno <- annotatePeak(
    peak,
    TxDb = txdb,
    tssRegion = c(-2000, 2000)
  )
  pdf(file.path(out_dir, paste0(sample_name, "_peakAnno_pie.pdf")),
      width = 6, height = 6)
  plotAnnoPie(peakAnno)
  dev.off()
}
message("All pie plots saved to: ", out_dir)
'
