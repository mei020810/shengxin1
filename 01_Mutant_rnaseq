run_fastp () {
  local old_dir="$1"
  local old_prefix="$2"
  local new_prefix="$3"

  # PE自动识别接头；常用过滤阈值：Q20；最多30%低质；最多5个N；最短50bp
  fastp \
    -i "/mnt/nfs2/stu_fy/hms/Mutant_rnaseq_data/01.RawData/${old_dir}/${old_prefix}_1.fq.gz" \
    -I "/mnt/nfs2/stu_fy/hms/Mutant_rnaseq_data/01.RawData/${old_dir}/${old_prefix}_2.fq.gz" \
    -o "clean/${new_prefix}_R1.clean.fq.gz" \
    -O "clean/${new_prefix}_R2.clean.fq.gz" \
    -h "qc/${new_prefix}.fastp.html" \
    -j "qc/${new_prefix}.fastp.json" \
    --detect_adapter_for_pe \
    -q 20 -u 30 -n 5 -l 50 \
    -w 10 \
    2> "logs/${new_prefix}.fastp.log"
}

